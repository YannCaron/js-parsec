{
  "name": "@cyann/js-parsec",
  "version": "1.0.0",
  "description": "A js/ts LL(*) parsing library based on combinator framework.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/YannCaron/js-parsec"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --experimental-transform-types --test",
    "doc": "jsdoc --readme ./readme.md --destination ./doc ./",
    "prepack": "npm run build",
    "publish": "npm publish --access public"
  },
  "keywords": [
    "Lexer",
    "Parser",
    "AST",
    "LL",
    "LL*",
    "Packrat",
    "Combinator framework",
    "Factory"
  ],
  "author": "CyaNn",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^20.9.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@cyann/js-commons": "^0.2.7"
  }
}
